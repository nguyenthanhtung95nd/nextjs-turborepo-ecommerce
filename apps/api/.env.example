# Postgres connection. Only this project opens one.
DATABASE_URL="postgres://app:app@localhost:5432/ecommerce?sslmode=disable"

# Port the API listens on. Defaults to 3002 when unset.
PORT=3002

# Signs the API access token. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=YOUR_JWT_SECRET
